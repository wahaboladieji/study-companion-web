# =============================================================================
# AI Study Companion - Environment Configuration Example
# =============================================================================
# Copy this file to .env and uncomment/configure the values for your environment.
# All sensitive credentials and environment-specific settings are documented below.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION & SERVER
# ─────────────────────────────────────────────────────────────────────────────
# Runtime environment: "development", "test", or "production"
# NODE_ENV=development

# Base public URL of the application (required for callbacks, redirects, and CORS)
# Local: http://localhost:3000 | Production: https://yourdomain.com
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL / Prisma)
# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_study_companion?schema=public"

# Database connection pool size (optional, integer >= 1, defaults to 10)
# DATABASE_POOL_SIZE=10

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION & SECURITY
# ─────────────────────────────────────────────────────────────────────────────
# Secret key used for signing session JWT tokens and CSRF protection (min 32 characters)
# JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL SERVICE (SMTP)
# ─────────────────────────────────────────────────────────────────────────────
# SMTP provider host (e.g. smtp.gmail.com, smtp.sendgrid.net, smtp.mailgun.org, AWS SES)
# SMTP_HOST=smtp.example.com

# SMTP port (587 for STARTTLS, 465 for SSL)
# SMTP_PORT=587

# SMTP authentication credentials
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# Sender display name and email address for system emails
# SMTP_FROM="AI Study Companion <noreply@yourdomain.com>"

# ─────────────────────────────────────────────────────────────────────────────
# PAYMENT GATEWAY (Flutterwave)
# Get keys from: https://dashboard.flutterwave.com -> Settings -> API Keys
# ─────────────────────────────────────────────────────────────────────────────
# Secret key used server-side to initialize payments and verify transactions
# Test format: FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx-X | Live format: FLWSECK-xxxxxxxxxxxxxxxxxxxx-X
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-flutterwave-secret-key-X

# Webhook secret hash configured in Flutterwave Dashboard -> Webhooks
# FLUTTERWAVE_WEBHOOK_SECRET=your_webhook_secret_hash

# ─────────────────────────────────────────────────────────────────────────────
# ARTIFICIAL INTELLIGENCE PROVIDERS
# ─────────────────────────────────────────────────────────────────────────────
# Default AI provider ("deepseek" | "gemini", defaults to "deepseek")
# AI_DEFAULT_PROVIDER=deepseek

# --- DeepSeek Configuration ---
# API key from: https://platform.deepseek.com
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TEMPERATURE=0.7
# DEEPSEEK_MAX_TOKENS=4096
# DEEPSEEK_TOP_P=1.0
# DEEPSEEK_TIMEOUT_MS=30000
# DEEPSEEK_MAX_RETRIES=3

# --- Google Gemini Configuration ---
# API key from Google AI Studio: https://aistudio.google.com
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_VISION_MODEL=gemini-3.6-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# GEMINI_TEMPERATURE=0.7
# GEMINI_MAX_OUTPUT_TOKENS=4096
# GEMINI_TOP_P=0.95
# GEMINI_TOP_K=40
# GEMINI_TIMEOUT_MS=30000
# GEMINI_MAX_RETRIES=3

# ─────────────────────────────────────────────────────────────────────────────
# TASK-SPECIFIC AI OVERRIDES (Optional)
# ─────────────────────────────────────────────────────────────────────────────
# Study Notes generation
# STUDY_NOTES_PROVIDER=deepseek
# STUDY_NOTES_TEMPERATURE=0.5
# STUDY_NOTES_MAX_TOKENS=4096

# Flashcards generation
# FLASHCARDS_PROVIDER=deepseek
# FLASHCARDS_TEMPERATURE=0.7
# FLASHCARDS_MAX_TOKENS=2048

# Course Chat (RAG)
# CHAT_PROVIDER=deepseek
# CHAT_TEMPERATURE=0.3
# CHAT_MAX_TOKENS=2048

# Document OCR
# OCR_TEMPERATURE=0.0
# OCR_MAX_TOKENS=4096

# ─────────────────────────────────────────────────────────────────────────────
# OBJECT STORAGE (Cloudflare R2 / AWS S3 / S3-Compatible)
# In development, files fall back automatically to local filesystem (.storage/)
# In production, object storage is required.
# ─────────────────────────────────────────────────────────────────────────────
# S3 endpoint URL (e.g., https://<account_id>.r2.cloudflarestorage.com or s3.<region>.amazonaws.com)
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Access key ID from your storage provider
# S3_ACCESS_KEY_ID=your-access-key-id

# Secret access key from your storage provider
# S3_SECRET_ACCESS_KEY=your-secret-access-key

# Storage bucket name
# S3_BUCKET=your-bucket-name

# Storage region (defaults to "auto" for Cloudflare R2, or e.g. "us-east-1" for AWS S3)
# S3_REGION=auto

# ─────────────────────────────────────────────────────────────────────────────
# CACHE SERVICE (Redis - Optional)
# Falls back automatically to in-memory cache if unset
# ─────────────────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
